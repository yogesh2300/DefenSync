# Copy to .env and adjust values before starting the application.

# Required — used for JWT signing
SECRET_KEY=change-me-to-a-long-random-secret-key

# PostgreSQL (must match backend/core/config.py default unless you override)
# PostgreSQL — copy to .env and replace with YOUR local credentials.
# Do not overwrite an existing working .env with this example.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=cloudsync_db
DB_USER=postgres
DB_PASSWORD=your_local_postgres_password

# Optional — set to true to log SQL statements
DB_ECHO=false

# Application
DEBUG=false
LOG_LEVEL=INFO
ENVIRONMENT=development

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

# Bootstrap admin, created at startup when no admin exists (never duplicated).
# ADMIN_EMAIL must be a real mailbox: the admin signs in with it and receives the OTP there.
# The password is stored only as a hash. After changing ADMIN_PASSWORD, apply it explicitly:
#   python -m backend.bootstrap.default_admin --reset-password
# These are the DefenSync admin credentials, not the SMTP credentials below.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# CORS — include Vite ports (direct API access). The Vite dev proxy also forwards /api to :8000.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Log collector SSH — DEV FALLBACK ONLY (use Server Management in production)
COLLECTOR_SSH_HOST=localhost
COLLECTOR_SSH_PORT=22
COLLECTOR_SSH_USER=centos
COLLECTOR_SSH_PASSWORD=
# COLLECTOR_SSH_PRIVATE_KEY_PATH=/path/to/private_key

# Background multi-server collection scheduler (keep false unless SSH hosts are reachable)
SCHEDULER_ENABLED=false
COLLECTION_INTERVAL_MINUTES=15
COLLECTION_TAIL_LINES=500

# Hybrid ML persistence (relative to repo root)
MODEL_DIR=models
CORRELATION_WINDOW_MINUTES=15

# Datasets (file import, not live cloud APIs)
DATASET_ROOT=datasets
OPENSTACK_DATASET_PATH=OpenStack
BEHAVIORAL_DATASET_PATH=behavioral
BEHAVIORAL_MIN_BASELINE_SAMPLES=10
BEHAVIORAL_BASELINE_UPDATE_MAX_RISK=29

# Optional Azure Activity Log FILE import directory (JSON/CSV exports). Not live Azure monitoring.
# Place exported files under datasets/Azure/ and POST /api/v1/datasets/azure/import

# Optional LIVE Azure telemetry collector (read-only, Log Analytics Query API).
# Leave blank to keep the collector NOT_CONFIGURED; the rest of the app is unaffected.
# Service principal needs only the "Log Analytics Reader" role on the workspace.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_LOG_ANALYTICS_WORKSPACE_ID=
# Historical (start/end) collection bounds: longest single window, and how far back it may start.
CLOUD_COLLECTION_MAX_WINDOW_HOURS=168
CLOUD_COLLECTION_MAX_HISTORY_DAYS=90

# Optional n8n webhook (notification only - no automatic actions).
# Used for HIGH/CRITICAL incident notifications and every alternate successful
# LINUX/CLOUD log collection (2nd, 4th, 6th, … per tenant scope and source type).
# Leave blank to keep notifications NOT_CONFIGURED; collections and incidents are stored either way.
# The URL and token are secrets: never commit real values.
N8N_WEBHOOK_URL=
# Optional header sent with each request, matching an n8n "Header Auth" credential.
N8N_WEBHOOK_AUTH_HEADER=
N8N_WEBHOOK_AUTH_TOKEN=
N8N_WEBHOOK_TIMEOUT_SECONDS=3
# Comma-separated To addresses embedded as body.notification.recipient_emails for n8n
# (expression: {{$json.body.notification.recipient_emails[0]}}). Leave blank to use the
# collecting owner's DefenSync login email only. Never commit real addresses.
N8N_NOTIFICATION_RECIPIENT_EMAILS=

# Optional presentation telemetry: comma-separated owner emails. After a successful Cloud
# "Collect now" by that owner, clearly marked records (data_origin=PRESENTATION_SIMULATED)
# are added to their own cloud source. Leave blank in normal operation.
# Required for the Cloud DEMO privilege incident workflow (zero Azure rows still get one DEMO event).
PRESENTATION_TELEMETRY_EMAILS=
# One DEMO privilege incident per successful Cloud collect (default true). Set false to use the
# legacy 1–3 collection presentation interval instead.
CLOUD_DEMO_EVERY_SUCCESS=true
# One n8n webhook per DEMO Cloud collect (default true). Skips Cloud alternate every-2nd while
# enabled. Webhook HTTP acceptance is not proof the mailbox received email.
CLOUD_DEMO_N8N_EVERY_SUCCESS=true

# Sign-in second factor (one-time code). Password login is REFUSED until email delivery is configured.
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=120
OTP_MAX_SENDS=3
# SMTP for emailing codes. For Gmail use smtp.gmail.com:587 with an App Password
# (Google Account > Security > App passwords), never your normal Gmail password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# starttls (default) | ssl | none (none is accepted only for a localhost relay)
SMTP_SECURITY=starttls
# SMS delivery has no provider implementation yet; leave blank ("SMS provider not configured").
SMS_PROVIDER=
